# Copy this file to .env in the project root. NEVER COMMIT .env.
# Create an OAuth2 API client on your OpenSky Network account page.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Standard accounts have 4000 credits/day for /states/*.
# Optional project-local rolling 24-hour cap. Leave blank for default of 3800.
# This does NOT track calls made elsewhere or persist after a server restart.
OPENSKY_DAILY_CREDIT_BUDGET=3800
